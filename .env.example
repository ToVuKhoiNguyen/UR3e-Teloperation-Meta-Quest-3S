# ==============================================================================
# Teleop Quest - Cấu hình Môi trường Triển khai (Zero-Setup Deployment)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env: cp .env.example .env
# 2. Chỉnh sửa ROBOT_IP và CAM_URL cho khớp với dải mạng thực tế của thiết bị
# 3. Khởi chạy: docker compose up -d
# ==============================================================================

# [BẮT BUỘC] Địa chỉ IP của Robot UR3e trên mạng LAN nội bộ
# Ví dụ: 10.42.0.242 (Robot thật) hoặc 127.0.0.1 (URSim mô phỏng)
ROBOT_IP=10.42.0.242

# [BẮT BUỘC] URL stream Camera RealSense qua giao thức ZeroMQ SUB
# Cổng mặc định của camera node là 5555
CAM_URL=tcp://10.42.0.100:5555

# Chế độ điều khiển Robot: 'real' (Robot thật) hoặc 'sim' (Mô phỏng URSim)
ROBOT_MODE=real

# Loại Camera: 'real' (Camera thật), 'synthetic' (Camera 3D ảo mô phỏng)
CAMERA_TYPE=real

# Phương thức kết nối Camera: 'eth' (Ethernet ZMQ), 'usb' (Cắm trực tiếp USB)
CAM_SOURCE=eth

# Python buffering
PYTHONUNBUFFERED=1
